# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ohlc

# Query Limits
OHLC_LIMIT=500

# Dataset Configuration - Database Schema Mapping
# Table/view name containing OHLC data
DATASET__TABLE=ohlc

# Column names in your database
DATASET__TIME_COLUMN=time
DATASET__OPEN_COLUMN=open
DATASET__HIGH_COLUMN=high
DATASET__LOW_COLUMN=low
DATASET__CLOSE_COLUMN=close
DATASET__VOLUME_COLUMN=volume
DATASET__SYMBOL_COLUMN=symbol
DATASET__TIMEFRAME_COLUMN=timeframe

# Additional columns to include in API responses (comma-separated)
DATASET__EXTRA_COLUMNS=rsi,atr,sma_20